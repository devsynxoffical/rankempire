# RankEmpire static site on Hostinger (Apache / LiteSpeed)
Options -MultiViews -Indexes
DirectoryIndex index.html
DirectorySlash On

<IfModule mod_rewrite.c>
RewriteEngine On

# 1) Force HTTPS and www (one redirect)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.rankempire.us/$1 [R=301,L]

# 2) Add the trailing slash to page URLs (/about-us -> /about-us/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
RewriteRule ^(.*)$ https://www.rankempire.us/$1/ [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

# Correct content types
AddType text/plain .txt
AddType application/xml .xml
AddType image/webp .webp
AddType video/mp4 .mp4
AddType font/woff2 .woff2
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .txt .xml .css .js

# Caching: long for build assets and media, short for pages
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|png|jpg|jpeg|svg|mp4|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/xml image/svg+xml
</IfModule>
